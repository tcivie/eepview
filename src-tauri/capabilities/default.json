{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome",
  "description": "The bundled toolbar and internal pages: every eepview command and events. Remote tab-* webviews are not named here, so they get no IPC.",
  "webviews": ["toolbar", "internal"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-select",
    "allow-tab-move",
    "allow-tab-list",
    "allow-navigate",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-stop",
    "allow-home",
    "allow-find",
    "allow-find-close",
    "allow-zoom-in",
    "allow-zoom-out",
    "allow-zoom-reset",
    "allow-site-js-set",
    "allow-bookmarks-list",
    "allow-bookmark-add",
    "allow-bookmark-update",
    "allow-bookmark-remove",
    "allow-bookmark-find",
    "allow-bookmarks-export",
    "allow-bookmarks-export-file",
    "allow-bookmarks-import",
    "allow-history-query",
    "allow-history-remove",
    "allow-history-clear",
    "allow-suggest",
    "allow-settings-get",
    "allow-settings-set",
    "allow-router-status",
    "allow-router-stats",
    "allow-chrome-set-height",
    "allow-platform",
    "allow-chrome-insets",
    "allow-window-fullscreen",
    "allow-connection-pause",
    "allow-connection-resume",
    "allow-router-control"
  ]
}
