{
  "name": "eepview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:coverage": "./scripts/check-tested.sh && node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 --test-coverage-exclude=\"src/**/*.test.ts\" \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@taplo/cli": "0.7.0",
    "@tauri-apps/cli": "^2",
    "happy-dom": "20.14.5",
    "typescript": "~7.0.2",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "allowScripts": {
    "fsevents": false
  }
}
